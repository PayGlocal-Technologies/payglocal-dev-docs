{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "sequoia",
  "name": "PayGlocal Developers",
  "colors": {
    "primary": "#1A6FE8",
    "light": "#4A90E8",
    "dark": "#1A6FE8"
  },
  "favicon": "/logo/favicon.svg",
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png"
  },
  "font": {
    "headings": {
      "family": "Outfit"
    },
    "body": {
      "family": "Outfit"
    }
  },
  "background": {
    "decoration": "grid"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Introduction",
            "pages": [
              "introduction"
            ]
          },
          {
            "group": "Onboarding",
            "pages": [
              "onboarding/overview",
              "guides/merchant-requirements",
              "guides/api-flow-overview",
              "authentication",
              "guides/partner-onboarding-events",
              "guides/iframe-integration"
            ]
          },
          {
            "group": "Dashboard",
            "pages": [
              "getting-started/payglocal-dashboards",
              "getting-started/dashboard-and-key-management"
            ]
          },
          {
            "group": "Integration",
            "pages": [
              "integration/overview",
              {
                "group": "No-Code Integration",
                "icon": "sparkles",
                "pages": [
                  "no-code/overview",
                  "no-code/payment-link",
                  "no-code/invoice-link",
                  "no-code/payment-button"
                ]
              },
              {
                "group": "API Integration",
                "icon": "code",
                "pages": [
                  "integration/api-overview",
                  {
                    "group": "Integration Modes",
                    "icon": "shuffle",
                    "pages": [
                      "merchant/paycollect/overview",
                      "merchant/paydirect/overview"
                    ]
                  },
                  {
                    "group": "Payment Types",
                    "icon": "layer-group",
                    "pages": [
                      "merchant/regular-payment",
                      "api-reference/payment/upi",
                      "merchant/recurring-payment",
                      "merchant/auth-capture-guide",
                      "merchant/paycollect/codedrop"
                    ]
                  }
                ]
              }
            ]
          },
          {
            "group": "Integration Resources",
            "pages": [
              "merchant/payment-flow",
              "merchant/webhooks",
              "merchant/payment-response-handling",
              "merchant/sdks"
            ]
          },
          {
            "group": "Merchant store plugins",
            "pages": [
              "plugins/overview",
              "plugins/shopify",
              "plugins/woocommerce",
              "plugins/magento",
              "plugins/opencart",
              "plugins/wix"
            ]
          },
          {
            "group": "MCA Integration",
            "pages": [
              "mca/overview",
              "mca/account-fetch",
              "mca/webhooks",
              "mca/document-upload"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Partner APIs: Merchant Onboarding",
            "pages": [
              "api-reference/onboarding-overview",
              "api-reference/create-onboarding",
              "api-reference/update-business-details",
              "api-reference/add-beneficial-owner",
              "api-reference/update-bank-details",
              "api-reference/update-auth-signatory",
              "api-reference/upload-documents",
              "api-reference/configure-products",
              "api-reference/get-verification-redirect",
              "api-reference/get-status",
              "api-reference/get-business-categories"
            ]
          },
          {
            "group": "Payment APIs",
            "icon": "credit-card",
            "expanded": true,
            "pages": [
              "api-reference/payment/overview",
              {
                "group": "Seamless Flow (PayDirect)",
                "icon": "code",
                "expanded": true,
                "pages": [
                  "api-reference/payments-v2/paydirect/overview",
                  "api-reference/payments-v2/paydirect/gpi",
                  "api-reference/payments-v2/paydirect/si-on-demand",
                  "api-reference/payments-v2/paydirect/si-auto-debit",
                  "api-reference/payments-v2/paydirect/auth-capture-authorise"
                ]
              },
              {
                "group": "Checkout Flow (PayCollect)",
                "icon": "window",
                "expanded": true,
                "pages": [
                  "api-reference/payments-v2/paycollect/overview",
                  "api-reference/payments-v2/paycollect/gpi",
                  "api-reference/payments-v2/paycollect/si-on-demand",
                  "api-reference/payments-v2/paycollect/si-auto-debit",
                  "api-reference/payments-v2/paycollect/auth-capture-authorise"
                ]
              },
              {
                "group": "Standing Instruction Sale",
                "icon": "repeat",
                "expanded": true,
                "pages": [
                  "api-reference/standing-instructions/si-subsequent-payment",
                  "api-reference/standing-instructions/si-status",
                  "api-reference/standing-instructions/si-cancellation"
                ]
              },
              {
                "group": "Capture & reversal",
                "icon": "shield-check",
                "expanded": true,
                "pages": [
                  "api-reference/payment/standalone-capture",
                  "api-reference/payment/standalone-reversal"
                ]
              },
              {
                "group": "Status",
                "icon": "signal",
                "expanded": true,
                "pages": [
                  "api-reference/payments-v2/common/get-transaction-status"
                ]
              },
              {
                "group": "Refund",
                "icon": "undo",
                "expanded": true,
                "pages": [
                  "api-reference/payment/refund"
                ]
              },
              {
                "group": "CodeDrop",
                "icon": "square-code",
                "expanded": true,
                "pages": [
                  "api-reference/codedrop"
                ]
              },
              {
                "group": "Callback Handling",
                "icon": "webhook",
                "expanded": true,
                "pages": [
                  "api-reference/callback-handling"
                ]
              },
              {
                "group": "Payload Templates",
                "icon": "clipboard-list",
                "expanded": true,
                "pages": [
                  "api-reference/payload-templates"
                ]
              }
            ]
          },
          {
            "group": "Partner APIs: MCA",
            "pages": [
              "api-reference/mca/overview",
              "api-reference/mca/account-fetch",
              "api-reference/mca/document-upload"
            ]
          }
        ]
      }
    ]
  },
